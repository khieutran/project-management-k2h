{
    "name": "project-management-k2h",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@12.3.4",
    "engines": {
        "node": "24.x",
        "pnpm": "12.x"
    },
    "scripts": {
        "dev": "pnpm --parallel --filter @project-management/api --filter @project-management/web run dev",
        "build": "pnpm -r --if-present run build",
        "lint": "pnpm -r --if-present run lint",
        "typecheck": "pnpm -r --if-present run typecheck",
        "test": "pnpm -r --if-present run test",
        "test:e2e": "pnpm --filter @project-management/api run test:e2e"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.11.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1"
    }
}